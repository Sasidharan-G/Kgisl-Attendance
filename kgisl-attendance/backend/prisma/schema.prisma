// ============================================================
// KGiSL-IIM Smart Attendance — Dynamic QR Module
// Prisma Schema (PostgreSQL)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Reference / supporting entities (minimal — extend as needed)
// ------------------------------------------------------------

model Faculty {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true) @map("is_active")
  // Admin-issued initial passwords must be replaced at first login.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  sessions    AttendanceSession[]
  allocations TimetableAllocation[]
  mentoredBatches Batch[] @relation("BatchMentor")

  @@map("faculty")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")

  @@map("admin")
}

model Student {
  id           String   @id @default(uuid())
  name         String
  rollNo       String   @unique @map("roll_no")
  regNo        String   @unique @map("reg_no")
  batchId      String   @map("batch_id")
  email        String   @unique
  passwordHash String
  deviceId     String?  @map("device_id") // bound device for anti-sharing checks
  createdAt    DateTime @default(now())
  isActive     Boolean  @default(true) @map("is_active")
  archivedAt   DateTime? @map("archived_at")
  mustChangePassword Boolean @default(false) @map("must_change_password")

  batch         Batch              @relation(fields: [batchId], references: [id])
  records       AttendanceRecord[]
  leaveRequests LeaveRequest[]
  correctionRequests AttendanceCorrectionRequest[]
  passkeys      StudentPasskey[]

  @@index([archivedAt])
  @@map("student")
}

// Face ID / Touch ID / Windows Hello credential used as the student's web device binding.
// Only the public key is stored; the private key never leaves the student's device.
model StudentPasskey {
  id           String    @id @default(uuid())
  studentId    String    @map("student_id")
  credentialId String    @unique @map("credential_id") // base64url
  publicKey    Bytes     @map("public_key")
  counter      Int       @default(0)
  transports   String[]
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_passkey")
}

enum BatchLifecycle {
  ACTIVE
  ARCHIVE_PENDING
  ARCHIVED
}

enum CorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceCorrectionRequest {
  id          String @id @default(uuid())
  studentId   String @map("student_id")
  sessionId   String @map("session_id")
  reason      String
  status      CorrectionRequestStatus @default(PENDING)
  reviewNote  String? @map("review_note")
  reviewedBy  String? @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [sessionId])
  @@unique([studentId, sessionId])
  @@index([status, createdAt])
  @@map("attendance_correction_request")
}

model Batch {
  id           String                @id @default(uuid())
  name         String                @unique // e.g. "MCA - II Year A"
  department   String                @default("Computer Applications")
  programme    String                @default("MCA")
  semester     Int                   @default(1)
  academicYear String                @default("2026-2027") @map("academic_year")
  mentorId     String?               @map("mentor_id")
  completionDate DateTime?           @map("completion_date")
  lifecycle    BatchLifecycle        @default(ACTIVE)
  archiveRequestedAt DateTime?       @map("archive_requested_at")
  archivedAt   DateTime?             @map("archived_at")
  mentor       Faculty?              @relation("BatchMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students     Student[]
  sessions     AttendanceSession[]
  allocations  TimetableAllocation[]
  blockTests   BlockTest[]

  @@index([mentorId])
  @@index([lifecycle, completionDate])
  @@map("batch")
}

model Subject {
  id          String                @id @default(uuid())
  name        String
  code        String                @unique
  sessions    AttendanceSession[]
  allocations TimetableAllocation[]

  @@map("subject")
}

model Room {
  id                 String                @id @default(uuid())
  name               String                @unique // e.g. "302 - MCA Lab"
  latitude           Float
  longitude          Float
  geofenceRadiusM    Int                   @default(120) @map("geofence_radius_m")
  sessions           AttendanceSession[]
  allocations        TimetableAllocation[]
  beacons            ClassroomBeacon[]

  @@map("room")
}

model ClassroomBeacon {
  id        String   @id @default(uuid())
  beaconId  Int      @unique @map("beacon_id")
  name      String
  roomId    String   @map("room_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, enabled])
  @@map("classroom_beacon")
}

model TimetableAllocation {
  id        String   @id @default(uuid())
  facultyId String   @map("faculty_id")
  subjectId String   @map("subject_id")
  batchId   String   @map("batch_id")
  roomId    String   @map("room_id")
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([facultyId, dayOfWeek, startTime])
  @@index([facultyId, dayOfWeek])
  @@map("timetable_allocation")
}

// ------------------------------------------------------------
// Core attendance tables (as specified in requirements)
// ------------------------------------------------------------

enum SessionStatus {
  ACTIVE
  PAUSED
  ENDED
  EXPIRED
}

model AttendanceSession {
  sessionId      String        @id @default(uuid()) @map("session_id")
  facultyId      String        @map("faculty_id")
  subjectId      String        @map("subject_id")
  roomId         String        @map("room_id")
  batchId        String        @map("batch_id")
  status         SessionStatus @default(ACTIVE)
  startedAt      DateTime      @default(now()) @map("started_at")
  endedAt        DateTime?     @map("ended_at")
  scheduledEndAt DateTime?     @map("scheduled_end_at")
  sessionType    String        @default("SCHEDULED") @map("session_type")
  notes          String?
  // Timetable period this session was opened for (no FK: an allocation can be deleted later).
  // Lets a faculty member re-open the same period instead of creating a duplicate class.
  allocationId   String?       @map("allocation_id")

  createdAt DateTime @default(now()) @map("created_at")

  faculty Faculty @relation(fields: [facultyId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])
  batch   Batch   @relation(fields: [batchId], references: [id])

  qrHistory AttendanceQrHistory[]
  records   AttendanceRecord[]
  correctionRequests AttendanceCorrectionRequest[]

  @@index([status])
  @@map("attendance_session")
}

model AttendanceQrHistory {
  id              String    @id @default(uuid())
  sessionId       String    @map("session_id")
  tokenHash       String    @map("token_hash") // SHA-256 hash — raw token NEVER stored
  nonce           String
  generatedAt     DateTime  @default(now()) @map("generated_at")
  expiresAt       DateTime  @map("expires_at")
  isExpired       Boolean   @default(false) @map("is_expired")
  revoked         Boolean   @default(false)

  session AttendanceSession @relation(fields: [sessionId], references: [sessionId])

  @@unique([tokenHash])
  @@index([sessionId, expiresAt])
  @@map("attendance_qr_history")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_DUTY
  LEAVE
  REJECTED_DUPLICATE
  REJECTED_EXPIRED
  REJECTED_GEOFENCE
  REJECTED_INVALID_SIGNATURE
}

enum AttendanceMethod {
  QR
  BEACON
  FACULTY_MANUAL
}

model AttendanceRecord {
  id                         String           @id @default(uuid())
  studentId                  String           @map("student_id")
  sessionId                  String           @map("session_id")
  scanTime                   DateTime         @default(now()) @map("scan_time")
  gpsLat                     Float?           @map("gps_lat")
  gpsLng                     Float?           @map("gps_lng")
  gpsAccuracy                Float?           @map("gps_accuracy")
  distanceFromCampus         Float?           @map("distance_from_campus")
  locationVerified           Boolean          @default(false) @map("location_verified")
  locationVerificationStatus String?          @map("location_verification_status")
  locationVerifiedAt         DateTime?        @map("location_verified_at")
  status                     AttendanceStatus @default(PRESENT)
  method                     AttendanceMethod @default(QR)
  deviceId                   String?          @map("device_id")
  markedByFacultyId          String?          @map("marked_by_faculty_id")
  overrideReason             String?          @map("override_reason")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  student Student           @relation(fields: [studentId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [sessionId])

  // A student can only ever have ONE successful PRESENT record per session.
  @@unique([studentId, sessionId], name: "uq_student_session")
  @@index([sessionId])
  @@index([method])
  @@map("attendance_record")
}

enum LeaveRequestType {
  LEAVE
  ON_DUTY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String             @id @default(uuid())
  studentId  String             @map("student_id")
  type       LeaveRequestType
  fromDate   DateTime           @map("from_date")
  toDate     DateTime           @map("to_date")
  reason     String
  status     LeaveRequestStatus @default(PENDING)
  reviewNote String?            @map("review_note")
  reviewedBy String?            @map("reviewed_by")
  reviewedAt DateTime?          @map("reviewed_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@map("leave_request")
}

// ------------------------------------------------------------
// Academic calendar (holidays, exams, events) and block-test timetable.
// Previously these were hard-coded in the browser, so nothing an administrator
// entered was ever saved or visible to students.
// ------------------------------------------------------------

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
  WORKING
}

model CalendarEvent {
  id          String            @id @default(uuid())
  date        DateTime          @db.Date
  title       String
  type        CalendarEventType @default(EVENT)
  description String            @default("")
  createdBy   String?           @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([date])
  @@map("calendar_event")
}

model BlockTest {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  subjectCode String   @map("subject_code")
  subjectName String   @map("subject_name")
  room        String
  // null = applies to every section.
  batchId     String?  @map("batch_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  batch Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([batchId, date])
  @@map("block_test")
}

// ------------------------------------------------------------
// Security: Audit Logging
// ------------------------------------------------------------

enum ActorType {
  ADMIN
  FACULTY
  STUDENT
  SYSTEM
}

// Durable, append-only record of every security-relevant event:
// auth (login/refresh/logout/failed attempts), session lifecycle,
// and every scan outcome (accepted AND rejected, with reason).
// Redis holds live session/refresh-token state; this table is the
// permanent, queryable trail for compliance/incident review.
model AuditLog {
  id         String    @id @default(uuid())
  actorId    String?   @map("actor_id") // null for pre-auth events e.g. failed login by unknown email
  actorType  ActorType @map("actor_type")
  action     String // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "SCAN_ACCEPTED", "SCAN_REJECTED", "SESSION_STARTED"
  success    Boolean   @default(true)
  reasonCode String?   @map("reason_code") // e.g. AppError.code on failure
  sessionId  String?   @map("session_id") // attendance session, if applicable
  ip         String?
  userAgent  String?   @map("user_agent")
  metadata   Json? // small structured extra context (never secrets/tokens)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([sessionId])
  @@map("audit_log")
}
