# ---- Server ----
PORT=4000
NODE_ENV=production

# ---- Database ----
DATABASE_URL="postgresql://user:password@localhost:5432/kgisl_attendance?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- JWT ----
JWT_ACCESS_SECRET="replace-with-64-byte-random-secret"
JWT_ACCESS_TTL="15m"

# Separate secret for refresh tokens (never reuse the access-token secret).
JWT_REFRESH_SECRET="replace-with-a-different-64-byte-random-secret"
JWT_REFRESH_TTL_SECONDS=604800

# ---- Auth brute-force protection ----
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---- QR / HMAC ----
# 256-bit (32 byte) hex key used to HMAC-SHA256 sign every QR payload.
QR_HMAC_SECRET="replace-with-64-hex-char-random-key"
QR_REFRESH_INTERVAL_SECONDS=10
QR_CLOCK_SKEW_TOLERANCE_SECONDS=2

# ---- BLE beacon token / HMAC ----
# Independent secret pepper for HMAC lookup of short-lived BLE beacon tokens.
# Generate at least 32 random characters; never reuse a JWT or QR secret.
BEACON_TOKEN_PEPPER="replace-with-an-independent-random-secret-at-least-32-characters"
BEACON_TOKEN_TTL_SECONDS=30

# ---- ESP32 BLE beacon / HMAC ----
# Independent 256-bit key used only by the backend to authenticate compact BLE packets.
BEACON_HMAC_SECRET="replace-with-a-different-64-hex-char-random-key"
BEACON_PACKET_TTL_SECONDS=30
BEACON_CLOCK_SKEW_SECONDS=3
BEACON_MIN_RSSI_DBM=-95

# ---- WebAuthn passkeys (Face ID / Touch ID) ----
# RP ID = the bare domain students open (no scheme/port). Passkeys need HTTPS or localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="KGiSL Attendance"

# ---- Geofence ----
DEFAULT_GEOFENCE_RADIUS_M=120

# ---- Rate Limiting ----
SCAN_RATE_LIMIT_WINDOW_MS=60000
SCAN_RATE_LIMIT_MAX=10

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call the API / connect via WebSocket
FRONTEND_ORIGINS="http://localhost:5173"

# ---- Password reset email (create an API key at Resend and verify your sending domain) ----
RESEND_API_KEY="re_replace-with-production-api-key"
BREVO_API_KEY="replace-with-brevo-v3-api-key"
EMAIL_FROM="KGiSL Attendance <noreply@your-verified-domain.com>"
PASSWORD_RESET_TTL_SECONDS=600

# Gmail/Google Workspace SMTP alternative (use an App Password, never the account password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-sender@yourdomain.com"
SMTP_PASS="replace-with-16-character-google-app-password"

# ---- Google Sign-In (OAuth 2.0 Web Client ID; safe to expose, never add the client secret) ----
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

